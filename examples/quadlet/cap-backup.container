[Unit]
Description=Capstone MariaDB backup
Requires=capnet.network cap-mariadb.container cap-backups.volume
After=capnet.network cap-mariadb.container cap-backups.volume

[Container]
Image=docker.io/library/mariadb:11
ContainerName=cap-backup
Network=capnet
Volume=cap_backups:/backups
Secret=mariadb_root_password
Environment=TZ=UTC
# $$ and %% survive systemd expansion. The shell sees $(...) and %Y.
# Do not use ${ts}: systemd replaces an unset ${ts} with an empty string.
Exec=sh -lc 'set -eu; umask 077; printf "[client]\nuser=root\npassword=%%s\n" "$$(cat /run/secrets/mariadb_root_password)" > /tmp/client.cnf; mysqldump --defaults-extra-file=/tmp/client.cnf -h db --databases cap > "/backups/all-$$(date -u +%%Y%%m%%dT%%H%%M%%SZ).sql"'

[Service]
Type=oneshot
